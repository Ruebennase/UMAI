# Caddyfile.example — UMAI 0.1 Production Deployment Configuration
#
# Reverse-proxy setup for two independent domains hosting Application A and Application B
# on a single VPS with automatic TLS certificate provisioning.
#
# Replace 'app-a.example.org' and 'app-b.example.net' with your actual registered domain names.
#
# IMPORTANT: When PeerOrigin or PeerEmbedURL is a non-loopback origin, the demo servers
# (internal/demoapp) refuse to start with built-in demo keys or the default demo password
# even when listening on 127.0.0.1. Always supply explicit Ed25519 keys and credentials:
#
#   UMAI_SIGNING_PRIVATE_KEY=<app-a-priv-hex> \
#   UMAI_PEER_PUBLIC_KEY=<app-b-pub-hex> \
#   UMAI_AUTH_PASS=<strong-password-a> \
#   ./bin/app-a -addr 127.0.0.1:8081 -peer https://app-b.example.net
#
#   UMAI_SIGNING_PRIVATE_KEY=<app-b-priv-hex> \
#   UMAI_PEER_PUBLIC_KEY=<app-a-pub-hex> \
#   UMAI_AUTH_PASS=<strong-password-b> \
#   ./bin/app-b -addr 127.0.0.1:8082 \
#     -peer https://app-a.example.org \
#     -embed-url https://app-a.example.org/sync.html

# ==============================================================================
# Application A (Embedded Peer)
# ==============================================================================
app-a.example.org {
    # Reverse proxy to local Go server for App A
    reverse_proxy 127.0.0.1:8081 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
    }

    # Security Headers:
    # Content-Security-Policy frame-ancestors explicitly allows https://app-b.example.net
    # to embed Application A within an iframe.
    header {
        Content-Security-Policy "frame-ancestors 'self' https://app-b.example.net; default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -X-Frame-Options
    }

    # Enable compression
    encode gzip zstd

    # Logging
    log {
        output file /var/log/caddy/app-a.access.log
        format console
    }
}

# ==============================================================================
# Application B (Host Page)
# ==============================================================================
app-b.example.net {
    # Reverse proxy to local Go server for App B
    reverse_proxy 127.0.0.1:8082 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
    }

    # Security Headers:
    # Application B is the host and embeds App A via frame-src, but does not allow itself to be framed.
    header {
        Content-Security-Policy "frame-ancestors 'none'; frame-src 'self' https://app-a.example.org; default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "DENY"
    }

    # Enable compression
    encode gzip zstd

    # Logging
    log {
        output file /var/log/caddy/app-b.access.log
        format console
    }
}
